{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "pjm-cms",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "f340366c-a44d-4361-adb0-9233350e7f71",
      "database_name": "pjm-cms-db",
      "remote": true
    }
  ],
  "services": [],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "pjm-content-bucket",
      "preview_bucket_name": "pjm-content-bucket"
    }
  ]
}